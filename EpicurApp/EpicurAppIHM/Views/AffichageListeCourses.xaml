<Window x:Class="EpicurAppIHM.Views.AffichageListeCourses"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liste de Courses" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#E8DCCA"
        FontFamily="./Police/#Playfair Display">

    <Border BorderBrush="#8B1538" BorderThickness="3" CornerRadius="10" Margin="15">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tete -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="Liste de Courses" FontSize="24" FontWeight="Bold" Foreground="#D4AF37" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="txtMenuNom" FontSize="14" Foreground="#B8860B" HorizontalAlignment="Center" FontStyle="Italic" Margin="0,5,0,0"/>
            </StackPanel>

            <Rectangle Grid.Row="1" Height="2" Fill="#8B1538" Margin="0,20,0,20"/>

            <!-- Statistiques -->
            <Border Grid.Row="2" Background="#F5F5DC" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="txtNombreIngredients" FontWeight="Bold" Foreground="#8B1538"/>
                    <TextBlock x:Name="txtNombreCategories" Margin="20,0,0,0" FontWeight="Bold" Foreground="#8B1538"/>
                </StackPanel>
            </Border>

            <!-- Liste de courses -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ListView x:Name="ListViewListeCourses" BorderThickness="0" Background="Transparent">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#2E8B57" CornerRadius="3" Padding="8,4" Margin="0,10,0,5">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#D4AF37" 
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Ingredient.Nom}" VerticalAlignment="Center" FontSize="13" Foreground="#2C3E50"/>
                                </StackPanel>
                                
                                <Border Grid.Column="1" Background="#FFE4B5" CornerRadius="8" Padding="5,2">
                                    <TextBlock Text="{Binding Quantite, StringFormat='x{0}'}" 
                                               FontSize="11" FontWeight="Bold" Foreground="#8B4513"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>

            <!-- Boutons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="btnExporter"
                        Content="Exporter"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#2E8B57"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Exporter_Click"/>
                
                <Button x:Name="btnFermer"
                        Content="Fermer"
                        Width="120"
                        Height="40"
                        Background="#D4AF37"
                        Foreground="#1a1a1a"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Fermer_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>