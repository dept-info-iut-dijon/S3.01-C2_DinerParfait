<Window x:Class="EpicurAppIHM.Views.HistoriqueRepas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EpicurAppIHM.Views"
        mc:Ignorable="d"
        Title="Historique des repas" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#E8DCCA"
        FontFamily="./Police/#Playfair Display">

    <Border BorderBrush="#8B1538" BorderThickness="3" CornerRadius="10" Margin="15">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="Epicur'app" FontSize="24" FontWeight="Bold"
                          Foreground="#D4AF37" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="txtTitreClient" Text="Historique des repas" FontSize="14" Foreground="#B8860B"
                          HorizontalAlignment="Center" FontStyle="Italic" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Ligne de séparation -->
            <Rectangle Grid.Row="1" Height="2" Fill="#8B1538" Margin="0,20,0,20"/>

            <!-- Zone de contenu -->
            <Border Grid.Row="2" BorderBrush="#D4AF37" BorderThickness="2" CornerRadius="8" Background="#2a2a2a">
                <Grid>
                    <!-- Message "Aucun repas enregistré" -->
                    <TextBlock x:Name="txtAucunRepas"
                              Text="Aucun repas enregistré"
                              FontSize="16"
                              Foreground="#D4AF37"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"/>

                    <!-- DataGrid pour afficher les repas -->
                    <DataGrid x:Name="dgRepas"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             Background="#2a2a2a"
                             Foreground="White"
                             BorderThickness="0"
                             GridLinesVisibility="Horizontal"
                             HorizontalGridLinesBrush="#3a3a3a"
                             RowBackground="#2a2a2a"
                             AlternatingRowBackground="#353535"
                             HeadersVisibility="Column"
                             CanUserResizeRows="False"
                             SelectionMode="Single"
                             SelectionUnit="FullRow"
                             Margin="10">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#8B1538"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Colonne Date -->
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Colonne Menu -->
                            <DataGridTextColumn Header="Menu" Binding="{Binding Menu.Nom}" Width="*" MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#D4AF37"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Colonne Retours -->
                            <DataGridTextColumn Header="Retours" Binding="{Binding Retours}" Width="*" MinWidth="250">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Bouton Fermer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="btnFermer" Content="Fermer" Width="150" Height="45"
                       Background="Transparent" Foreground="#D4AF37"
                       BorderBrush="#D4AF37" BorderThickness="2" FontSize="15"
                       FontWeight="SemiBold" Cursor="Hand" Click="Fermer"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
