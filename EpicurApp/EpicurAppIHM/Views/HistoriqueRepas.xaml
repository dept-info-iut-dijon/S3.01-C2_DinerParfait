<Window x:Class="EpicurAppIHM.Views.HistoriqueRepas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EpicurAppIHM.Views"
        mc:Ignorable="d"
        Title="Historique des repas" Width="950" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#FDF6E3"
        FontFamily="./Police/#Playfair Display">

    <Window.Resources>
        <Style x:Key="StarIcon" TargetType="Path">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Fill" Value="#CBD5E1"/>
            <Setter Property="Data" Value="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#8B1538" BorderThickness="3" CornerRadius="10" Margin="15">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="Epicur'app" FontSize="24" FontWeight="Bold"
                           Foreground="#8B1538" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="txtTitreClient" Text="Historique des repas" FontSize="14" Foreground="#D4AF37"
                           HorizontalAlignment="Center" FontStyle="Italic" Margin="0,5,0,0"/>
            </StackPanel>

            <Rectangle Grid.Row="1" Height="2" Fill="#8B1538" Margin="0,20,0,20"/>

            <Border Grid.Row="2" BorderBrush="#D4AF37" BorderThickness="2" CornerRadius="8" Background="White">
                <Grid>
                    <TextBlock x:Name="txtAucunRepas"
                               Text="Aucun repas enregistré"
                               FontSize="16"
                               Foreground="#D4AF37"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <DataGrid x:Name="dgRepas"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="White"
                              Foreground="#475569"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F8FAFC"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              HeadersVisibility="Column"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Margin="10">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#8B1538"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.ItemContainerStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FDF6E3"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.ItemContainerStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Menu" Binding="{Binding Menu.Nom}" Width="*" MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#8B1538"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Avis" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                            <Border Tag="1" MouseLeftButtonUp="Star_Click_Handler" Cursor="Hand" Width="20" HorizontalAlignment="Center">
                                                <Path>
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource StarIcon}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="1">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="2">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="3">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="4">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="5">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>

                                            <Border Tag="2" MouseLeftButtonUp="Star_Click_Handler" Cursor="Hand" Width="20" HorizontalAlignment="Center">
                                                <Path>
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource StarIcon}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="2">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="3">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="4">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="5">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>

                                            <Border Tag="3" MouseLeftButtonUp="Star_Click_Handler" Cursor="Hand" Width="20" HorizontalAlignment="Center">
                                                <Path>
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource StarIcon}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="3">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="4">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="5">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>

                                            <Border Tag="4" MouseLeftButtonUp="Star_Click_Handler" Cursor="Hand" Width="20" HorizontalAlignment="Center">
                                                <Path>
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource StarIcon}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="4">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="5">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>

                                            <Border Tag="5" MouseLeftButtonUp="Star_Click_Handler" Cursor="Hand" Width="20" HorizontalAlignment="Center">
                                                <Path>
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource StarIcon}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Menu.Note}" Value="5">
                                                                    <Setter Property="Fill" Value="#D4AF37"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                    
                            <DataGridTextColumn Header="Retours" Binding="{Binding Retours}" Width="*" MinWidth="250">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="btnFermer" Content="Fermer" Width="150" Height="45"
                        Background="Transparent" Foreground="#D4AF37"
                        BorderBrush="#D4AF37" BorderThickness="2" FontSize="15"
                        FontWeight="SemiBold" Cursor="Hand" Click="Fermer"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>