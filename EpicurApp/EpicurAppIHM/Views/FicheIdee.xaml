<Window x:Class="EpicurAppIHM.Views.FicheIdee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nouvelle Idée" Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#E8DCCA">

    <Border BorderBrush="#8B1538" BorderThickness="3" CornerRadius="10" Margin="15">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <TextBlock Grid.Row="0" Text="Boîte à Idées" FontSize="24" FontWeight="Bold" 
                      Foreground="#D4AF37" HorizontalAlignment="Center" Margin="0,5,0,0"/>

            <!-- Ligne de séparation -->
            <Rectangle Grid.Row="1" Height="2" Fill="#8B1538" Margin="0,20,0,20"/>

            <!-- Formulaire -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Titre de l'idée -->
                    <Label Content="Titre *" Foreground="#D4AF37" FontWeight="SemiBold" FontSize="13"/>
                    <Border BorderBrush="#D4AF37" BorderThickness="2" CornerRadius="8" Background="#2a2a2a">
                        <TextBox x:Name="txtTitre" Height="40" Padding="10" FontSize="14" 
                                Background="Transparent" Foreground="White" BorderThickness="0"/>
                    </Border>

                    <!-- Catégorie -->
                    <Label Content="Catégorie" Foreground="#D4AF37" FontWeight="SemiBold" 
                          FontSize="13" Margin="0,10,0,0"/>
                    <Border BorderBrush="#D4AF37" BorderThickness="2" CornerRadius="8" Background="White" Padding="5">
                        <ComboBox x:Name="cmbCategorie" Background="White" Foreground="Black" BorderThickness="0">
                            <ComboBoxItem Content="Entrée"/>
                            <ComboBoxItem Content="Plat principal"/>
                            <ComboBoxItem Content="Dessert"/>
                            <ComboBoxItem Content="Accompagnement"/>
                            <ComboBoxItem Content="Autre"/>
                        </ComboBox>
                    </Border>

                    <!-- Description -->
                    <Label Content="Description" Foreground="#D4AF37" FontWeight="SemiBold" 
                          FontSize="13" Margin="0,10,0,0"/>
                    <Border BorderBrush="#D4AF37" BorderThickness="2" CornerRadius="8" Background="#2a2a2a">
                        <TextBox x:Name="txtDescription" Height="80" Padding="10" FontSize="14"
                                Background="Transparent" Foreground="White" BorderThickness="0"
                                TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <!-- Notes -->
                    <Label Content="Notes personnelles" Foreground="#D4AF37" FontWeight="SemiBold" 
                          FontSize="13" Margin="0,10,0,0"/>
                    <Border BorderBrush="#D4AF37" BorderThickness="2" CornerRadius="8" Background="#2a2a2a">
                        <TextBox x:Name="txtNotes" Height="80" Padding="10" FontSize="14"
                                Background="Transparent" Foreground="White" BorderThickness="0"
                                TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Boutons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="btnAnnuler" Content="Annuler" Width="130" Height="45" 
                       Margin="0,0,15,0" Background="Transparent" Foreground="#D4AF37" 
                       BorderBrush="#D4AF37" BorderThickness="2" FontSize="15" 
                       FontWeight="SemiBold" Cursor="Hand" Click="Annuler_Click"/>
                <Button x:Name="btnEnregistrer" Content="Enregistrer" Width="130" Height="45"
                       Background="#D4AF37" Foreground="#1a1a1a" BorderThickness="0"
                       FontSize="15" FontWeight="Bold" Cursor="Hand" Click="Enregistrer_Click"/>
                <Button x:Name="btnSupprimer" Content="Supprimer" Width="130" Height="45" 
                       Margin="15,0,0,0" Background="#EF4444" Foreground="White" BorderThickness="0" 
                       FontSize="15" FontWeight="Bold" Cursor="Hand" Visibility="Collapsed" Click="Supprimer_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>