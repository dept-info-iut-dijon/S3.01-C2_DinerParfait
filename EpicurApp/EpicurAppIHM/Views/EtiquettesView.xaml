<Window x:Class="EpicurAppIHM.Views.EtiquettesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edition des Etiquettes" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FDF6E3"
        FontFamily="./Police/#Playfair Display">

    <Window.Resources>
        <Style x:Key="EpicurAppButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#8B1538" BorderThickness="3" CornerRadius="10" Margin="15" Background="#FDF6E3">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Edition des Etiquettes Nominatives" 
                           FontSize="24" FontWeight="Bold" Foreground="#8B1538" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Sélectionnez les invités et personnalisez l'impression" 
                           FontSize="14" Foreground="#475569" FontStyle="Italic"
                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <Rectangle Height="2" Fill="#D4AF37" Margin="50,15,50,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="1. Sélectionnez les invités :" FontWeight="Bold" Foreground="#8B1538" DockPanel.Dock="Top" Margin="0,0,0,10"/>

                    <DataGrid x:Name="DataGridInvites" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              BorderBrush="#D4AF37" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Impression" 
                                                    Binding="{Binding EstSelectionne, UpdateSourceTrigger=PropertyChanged}" 
                                                    Width="80"/>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="2. Personnalisation :" FontWeight="Bold" Foreground="#8B1538" Margin="0,0,0,15"/>

                    <Label Content="Date de l'événement :" FontWeight="SemiBold"/>
                    <DatePicker x:Name="datePickerEvenement" Height="35" Margin="0,0,0,15"/>

                    <Label Content="Message d'accueil (optionnel) :" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtMessage" 
                             Height="80" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             Padding="5"
                             BorderBrush="#D4AF37"
                             Margin="0,0,0,5"/>
                    <TextBlock Text="Ex: Bienvenue au dîner de gala" FontSize="11" Foreground="Gray" FontStyle="Italic"/>

                    <Border Background="#FFF9E6" BorderBrush="#D4AF37" BorderThickness="1" CornerRadius="5" Margin="0,30,0,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Format de sortie" FontWeight="Bold" Foreground="#D4AF37"/>
                            <TextBlock Text="PDF Format A6 (Carte Postale)" Margin="0,5,0,0"/>
                            <TextBlock Text="Police : Arial (Lisible)" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Fermer" Width="100" 
                        Background="Transparent" Foreground="#8B1538" BorderBrush="#8B1538" BorderThickness="2"
                        Style="{StaticResource EpicurAppButtonStyle}"
                        Margin="0,0,15,0"
                        Click="Fermer_Click"/>

                <Button Content="Générer le PDF" Width="180" 
                        Background="#8B1538" Foreground="White"
                        Style="{StaticResource EpicurAppButtonStyle}"
                        Click="GenererPDF_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>