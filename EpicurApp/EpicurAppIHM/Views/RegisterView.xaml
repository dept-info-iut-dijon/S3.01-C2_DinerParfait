<Window x:Class="EpicurAppIHM.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EpicurApp - Inscription"
        Height="700"
        Width="550"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#FDF6E3"
        FontFamily="./Police/#Playfair Display">

    <Window.Resources>
        <!-- Style pour les TextBox -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Style pour les PasswordBox -->
        <Style x:Key="InputPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Template pour les boutons avec coins arrondis -->
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">
                <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
        </ControlTemplate>

        <!-- Style pour le bouton principal -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B1538"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Partie gauche : Logo sur fond bordeaux -->
        <Border Grid.Column="0"
                Background="#8B1538">
            <Grid>
                <Image Source="/Logo/logosae1-bgremove.png"
                       Stretch="Uniform"
                       MaxWidth="500"
                       MaxHeight="500"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="50"/>
            </Grid>
        </Border>

        <!-- Partie droite : Formulaire d'inscription sur fond crème -->
        <Border Grid.Column="1"
                Background="#FDF6E3">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center"
                           MaxWidth="450"
                           Margin="60,40">

                    <!-- En-tête -->
                    <StackPanel HorizontalAlignment="Center"
                               Margin="0,0,0,40">
                        <TextBlock Text="EpicurApp"
                                  FontFamily="./Police/#Playfair Display"
                                  FontSize="40"
                                  FontWeight="Bold"
                                  Foreground="#8B1538"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="Inscription"
                                  FontSize="20"
                                  Foreground="#D4AF37"
                                  HorizontalAlignment="Center"
                                  FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Message d'erreur -->
                    <Border x:Name="ErrorBorder"
                            Background="#FEE2E2"
                            BorderBrush="#EF4444"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,0,0,20"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorMessage"
                                  Text="Une erreur est survenue"
                                  Foreground="#EF4444"
                                  FontSize="13"
                                  TextWrapping="Wrap"/>
                    </Border>

                    <!-- Email -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Email"
                                  Foreground="#475569"
                                  FontWeight="SemiBold"
                                  FontSize="14"
                                  Margin="0,0,0,8"/>
                        <Border Background="#2a2a2a"
                                BorderBrush="#D4AF37"
                                BorderThickness="2"
                                CornerRadius="8">
                            <TextBox x:Name="EmailTextBox"
                                    Style="{StaticResource InputTextBoxStyle}"/>
                        </Border>
                    </StackPanel>

                    <!-- Mot de passe -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Mot de passe"
                                  Foreground="#475569"
                                  FontWeight="SemiBold"
                                  FontSize="14"
                                  Margin="0,0,0,8"/>
                        <Border Background="#2a2a2a"
                                BorderBrush="#D4AF37"
                                BorderThickness="2"
                                CornerRadius="8">
                            <PasswordBox x:Name="PasswordBox"
                                        Style="{StaticResource InputPasswordBoxStyle}"
                                        PasswordChanged="PasswordBox_PasswordChanged"/>
                        </Border>
                        <!-- Indicateur de force du mot de passe -->
                        <TextBlock x:Name="PasswordStrengthIndicator"
                                  Text=""
                                  FontSize="12"
                                  Margin="0,5,0,0"
                                  Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Confirmation mot de passe -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Confirmer le mot de passe"
                                  Foreground="#475569"
                                  FontWeight="SemiBold"
                                  FontSize="14"
                                  Margin="0,0,0,8"/>
                        <Border Background="#2a2a2a"
                                BorderBrush="#D4AF37"
                                BorderThickness="2"
                                CornerRadius="8">
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                        Style="{StaticResource InputPasswordBoxStyle}"
                                        PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                        </Border>
                        <!-- Indicateur de correspondance -->
                        <TextBlock x:Name="PasswordMatchIndicator"
                                  Text=""
                                  FontSize="12"
                                  Margin="0,5,0,0"
                                  Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Nom du restaurant -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Nom du restaurant"
                                  Foreground="#475569"
                                  FontWeight="SemiBold"
                                  FontSize="14"
                                  Margin="0,0,0,8"/>
                        <Border Background="#2a2a2a"
                                BorderBrush="#D4AF37"
                                BorderThickness="2"
                                CornerRadius="8">
                            <TextBox x:Name="RestaurantNomTextBox"
                                    Style="{StaticResource InputTextBoxStyle}"/>
                        </Border>
                    </StackPanel>

                    <!-- Ville du restaurant -->
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Ville du restaurant"
                                  Foreground="#475569"
                                  FontWeight="SemiBold"
                                  FontSize="14"
                                  Margin="0,0,0,8"/>
                        <Border Background="#2a2a2a"
                                BorderBrush="#D4AF37"
                                BorderThickness="2"
                                CornerRadius="8">
                            <TextBox x:Name="RestaurantVilleTextBox"
                                    Style="{StaticResource InputTextBoxStyle}"/>
                        </Border>
                    </StackPanel>

                    <!-- Bouton d'inscription -->
                    <Button x:Name="RegisterButton"
                            Content="S'inscrire"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="RegisterButton_Click"
                            Margin="0,0,0,15"/>

                    <!-- Bouton retour à la connexion -->
                    <TextBlock HorizontalAlignment="Center"
                               Margin="0,0,0,15">
                        <Hyperlink Click="BackToLogin_Click"
                                  Foreground="#8B1538"
                                  TextDecorations="None">
                            <Run Text="Retour à la connexion"/>
                        </Hyperlink>
                    </TextBlock>

                    <!-- Indicateur de chargement -->
                    <StackPanel x:Name="LoadingPanel"
                               Orientation="Horizontal"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"
                               Margin="0,10,0,0">
                        <TextBlock Text="Création du compte en cours..."
                                  Foreground="#8B1538"
                                  FontSize="13"
                                  FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
