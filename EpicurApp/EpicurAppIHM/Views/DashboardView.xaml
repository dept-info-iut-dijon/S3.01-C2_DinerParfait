<UserControl x:Class="EpicurAppIHM.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#FDF6E3"
             FontFamily="/Police/#Playfair Display">

    <Grid Margin="15,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="320"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Text="Tableau de bord" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#8B1538"
                   Margin="0,0,0,8"
                   Grid.Row="0"/>

        <!-- 3 cartes statistiques - LARGEUR LIMITÉE -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8" Height="75">
            <!-- Carte 1 -->
            <Border Background="White" CornerRadius="5" Padding="10" Width="220"
            BorderBrush="#D4AF37" BorderThickness="2" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Clients" FontSize="10" Foreground="#666"/>
                    <TextBlock x:Name="TxtTotalClients" Text="0" FontSize="24" FontWeight="Bold" Foreground="#8B1538" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Carte 2 -->
            <Border Background="White" CornerRadius="5" Padding="10" Width="220"
            BorderBrush="#D4AF37" BorderThickness="2" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Réservations mois" FontSize="10" Foreground="#666"/>
                    <TextBlock x:Name="TxtReservationsMois" Text="0" FontSize="24" FontWeight="Bold" Foreground="#8B1538" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Carte 3 -->
            <Border Background="White" CornerRadius="5" Padding="10" Width="220"
            BorderBrush="#D4AF37" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="Inactifs (>1 an)" FontSize="10" Foreground="#666"/>
                    <TextBlock x:Name="TxtClientsInactifs" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FF6B6B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Graphique et Liste côte à côte - LARGEURS AUGMENTÉES -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Height="320">

            <!-- Graphique -->
            <Border Background="White" CornerRadius="6" Padding="12" Width="650"
                    BorderBrush="#D4AF37" BorderThickness="2" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Top 10 Clients Réguliers" 
                               FontSize="14" FontWeight="Bold" Foreground="#8B1538" 
                               Margin="0,0,0,5"/>
                    <lvc:CartesianChart x:Name="ChartPrincipal" Height="270" LegendLocation="None">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding}" FontSize="9" LabelsRotation="45"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Nombre" FontSize="9" MinValue="0"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>

            <!-- Liste -->
            <Border Background="White" CornerRadius="6" Padding="10" Width="350"
                    BorderBrush="#D4AF37" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="Clients à relancer (>1 an)" 
                               FontSize="12" FontWeight="Bold" Foreground="#8B1538" 
                               Margin="0,0,0,6"
                               TextWrapping="Wrap"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="275">
                        <ItemsControl x:Name="ListeClientsInactifs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF8F3E3" Padding="6" Margin="0,0,0,5" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#8B1538" TextWrapping="Wrap">
                                                <Run Text="{Binding Prenom}"/>
                                                <Run Text="{Binding Nom}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Email}" FontSize="9" Foreground="#666" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>