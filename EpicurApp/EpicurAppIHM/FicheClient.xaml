<Window x:Class="EpicurAppIHM.FicheClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EpicurAppIHM"
        mc:Ignorable="d"
        Title="Fiche Client" Height="750" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#E8DCCA">

    <Border BorderBrush="#D4AF37" 
            BorderThickness="3" 
            CornerRadius="10"
            Margin="15">

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="Epicur'app" 
                           FontSize="24" 
                           FontWeight="Bold"
                           Foreground="#D4AF37"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
                <TextBlock Text="Nouvelle Fiche Client" 
                           FontSize="14" 
                           Foreground="#B8860B"
                           HorizontalAlignment="Center"
                           FontStyle="Italic"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Ligne de séparation -->
            <Rectangle Grid.Row="1" 
                       Height="2" 
                       Fill="#D4AF37"
                       Margin="0,20,0,20"/>

            <!-- Formulaire -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Prénom -->
                    <Label Content="Prénom *" 
                           Foreground="#D4AF37" 
                           FontWeight="SemiBold"
                           FontSize="13"/>
                    <Border BorderBrush="#D4AF37" 
                            BorderThickness="2" 
                            CornerRadius="8"
                            Background="#2a2a2a">
                        <TextBox x:Name="txtPrenom" 
                                 Height="40"
                                 Padding="10"
                                 FontSize="14"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"/>
                    </Border>

                    <!-- Nom -->
                    <Label Content="Nom *" 
                           Foreground="#D4AF37" 
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,15,0,0"/>
                    <Border BorderBrush="#D4AF37" 
                            BorderThickness="2" 
                            CornerRadius="8"
                            Background="#2a2a2a">
                        <TextBox x:Name="txtNom" 
                                 Height="40"
                                 Padding="10"
                                 FontSize="14"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"/>
                    </Border>

                    <!-- Email -->
                    <Label Content="Email *" 
                           Foreground="#D4AF37" 
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,15,0,0"/>
                    <Border BorderBrush="#D4AF37" 
                            BorderThickness="2" 
                            CornerRadius="8"
                            Background="#2a2a2a">
                        <TextBox x:Name="txtEmail" 
                                 Height="40"
                                 Padding="10"
                                 FontSize="14"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"/>
                    </Border>

                    <!-- Téléphone -->
                    <Label Content="Téléphone *" 
                           Foreground="#D4AF37" 
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,15,0,0"/>
                    <Border BorderBrush="#D4AF37" 
                            BorderThickness="2" 
                            CornerRadius="8"
                            Background="#2a2a2a">
                        <TextBox x:Name="txtTelephone" 
                                 Height="40"
                                 Padding="10"
                                 FontSize="14"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"/>
                    </Border>

                    <!-- Carte Bancaire -->
                    <Label Content="Carte Bancaire *" 
                           Foreground="#D4AF37" 
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,15,0,0"/>
                    <Border BorderBrush="#D4AF37" 
                            BorderThickness="2" 
                            CornerRadius="8"
                            Background="#2a2a2a">
                        <TextBox x:Name="txtCarte" 
                                 Height="40"
                                 Padding="10"
                                 FontSize="14"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"
                                 MaxLength="19"/>
                    </Border>

                    <!-- Ligne de séparation -->
                    <Rectangle Height="1" 
                               Fill="#D4AF37"
                               Margin="0,25,0,15"/>

                    <!-- Allergies -->
                    <Label Content="Allergies" 
                           Foreground="#D4AF37" 
                           FontWeight="SemiBold"
                           FontSize="13"/>
                    <Border BorderBrush="#D4AF37" 
                            BorderThickness="2" 
                            CornerRadius="8"
                            Background="#2a2a2a">
                        <TextBox x:Name="txtAllergies" 
                                 Height="40"
                                 Padding="10"
                                 FontSize="14"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"/>
                    </Border>


                    <!-- Plats non appréciés -->
                    <Label Content="Plats non appréciés" 
                           Foreground="#D4AF37" 
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,15,0,0"/>
                    <Border BorderBrush="#D4AF37" 
                            BorderThickness="2" 
                            CornerRadius="8"
                            Background="#2a2a2a">
                        <TextBox x:Name="txtPlats" 
                                 Height="90"
                                 Padding="10"
                                 FontSize="14"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Boutons -->
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        Margin="0,25,0,0">

                <Button x:Name="btnAnnuler" 
                        Content="Annuler" 
                        Width="130" 
                        Height="45"
                        Margin="0,0,15,0"
                        Background="Transparent"
                        Foreground="#D4AF37"
                        BorderBrush="#D4AF37"
                        BorderThickness="2"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Click="Annuler"/>

                <Button x:Name="btnCreer" 
                        Content="Créer le client" 
                        Width="180" 
                        Height="45"
                        Background="#D4AF37"
                        Foreground="#1a1a1a"
                        BorderThickness="0"
                        FontSize="15"
                        FontWeight="Bold"
                        Click="CreerClient"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
